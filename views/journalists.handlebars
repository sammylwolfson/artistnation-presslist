<div class="table-wrapper">
	<div class="table-title title">
		<div class="row">
			<div class="col-xs-6">
					<h2><b>Manage Journalists</b></h2>
			</div>
		</div>
	</div>

	<div class="csv-toolbar row align-items-end gx-2 gy-2 my-3">
		<div class="col-auto">
			<a id="export-csv" class="btn" href="/api/journalists/export.csv">Export CSV</a>
		</div>
		<div class="col">
			<form id="import-form" class="row align-items-end gx-2 gy-2">
				<div class="col-auto">
					<label for="import-file" class="form-label mb-0">Import CSV</label>
					<input type="file" id="import-file" name="file" accept=".csv,text/csv" class="form-control form-control-sm">
				</div>
				<div class="col-auto">
					<label for="import-mode" class="form-label mb-0">Existing emails</label>
					<select id="import-mode" class="form-select form-select-sm">
						<option value="skip">Skip</option>
						<option value="update">Update</option>
					</select>
				</div>
				<div class="col-auto">
					<div class="form-check">
						<input class="form-check-input" type="checkbox" id="import-dry-run" checked>
						<label class="form-check-label" for="import-dry-run">Preview only</label>
					</div>
				</div>
				<div class="col-auto">
					<button type="submit" class="btn">Upload</button>
				</div>
				<div class="col-auto">
					<a href="/api/journalists/import-template.csv" class="small">Download blank template</a>
				</div>
			</form>
		</div>
	</div>
	<div id="import-status" class="import-status my-2" hidden></div>

	{{#if journalists}}
	<table class="table table-striped table-hover">
		<thead>
			<tr>
				<th id="sort-first-name">First Name</th>
				<th id="sort-last-name">Last Name</th>
				<th id="sort-company">Company</th>
				<th id="sort-email">Email</th>
				<th id="sort-city">City</th>
				<th id="sort-date-added">Date Added</th>
			</tr>
		</thead>
		<tbody>
			{{#each journalists as |journalist|}}
				<tr>
					<td>{{journalist.first_name}}</td>
					<td>{{journalist.last_name}}</td>
					<td>{{journalist.company}}</td>
					<td><a href="mailto:{{journalist.email}}">{{journalist.email}}</a></td>
					<td>{{journalist.city}}</td>
					<td>{{format_date journalist.created_at}}</td>
					<td>
						<a href="/edit/journalist/{{journalist.id}}" class="edit"><i class="material-icons">&#xE254;</i></a>
					</td>
				</tr>
			{{/each}}
		</tbody>
	</table>
    <a class="btn" href="mailto:?bcc={{#each journalists as |journalist|}} {{journalist.email}},{{/each}}">Email All Journalist</a>
	{{else}}
	<div class="row justify-content-center my-5">
		<h2 class="col-6 text-center">No journalist found matching this criteria.</h2>
	</div>
	<div class="row justify-content-center">
		<a href="/" class="btn-back text-light">Back To Search</a>
	</div>
	{{/if}}
</div>
<script src="/javascript/sort.js"></script>
<script src="/javascript/import-export.js"></script>
